FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY shared ./shared
COPY adme_platform ./adme_platform
COPY projects ./projects
COPY knowledge-base ./knowledge-base
RUN pip install --no-cache-dir -e ".[dev]"
RUN python -m data_generation.cli --seed 42 --output data/synthetic
EXPOSE 8000
CMD ["uvicorn", "adme_platform.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
