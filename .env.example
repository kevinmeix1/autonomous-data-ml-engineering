# LLM (optional — agents fall back to deterministic reasoning without keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADME_LLM_PROVIDER=openai

# Runtime
ADME_ENV=local
ADME_DATA_DIR=./data/synthetic
ADME_DB_URL=sqlite+aiosqlite:///./data/platform.db
ADME_REQUIRE_APPROVAL=true
ADME_LOG_LEVEL=INFO

# Simulation mode — never pretends to be real AWS
ADME_SAGEMAKER_MODE=local_simulation
ADME_SNOWFLAKE_MODE=local_simulation
